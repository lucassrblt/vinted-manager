# --- Backend ---
# Clé Fernet pour chiffrer le mot de passe IMAP : OBLIGATOIRE pour configurer la boîte mail.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Sur Railway : fourni par le service Postgres (le préfixe postgresql:// est converti automatiquement)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
# Dossier du volume pour les preuves, bordereaux, pièces jointes
# DATA_DIR=/data
# true en production (HTTPS), false en local
# COOKIE_SECURE=true
LOG_LEVEL=INFO
# Synchronisation des mails (minutes) ; SCHEDULER_ACTIF=false désactive les tâches planifiées
# INTERVALLE_SYNCHRO_MINUTES=5
# SCHEDULER_ACTIF=true

# --- Étape 3 : IA ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# IA_FACTICE=true  # démo / tests e2e uniquement : textes sans appel à l'API

# --- Étape 4 : notifications push ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@example.com

# --- Frontend (Vercel) ---
# BACKEND_URL=https://ton-backend.up.railway.app
